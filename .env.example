# -----------------------------
# Frontend / proxy configuration
# -----------------------------
# Next.js rewrites /api/* to the Go server (default http://localhost:8080 if unset).
# Go also reads GOAPI_ORIGIN for CORS Allow-Origin (default http://localhost:3000 if unset).
# If root .env.local is sourced for BOTH processes, avoid setting GOAPI_ORIGIN to the backend
# URL only—see README "GOAPI_ORIGIN in local dev". Uncomment only when you need a non-default backend URL for Next:
# GOAPI_ORIGIN=http://localhost:8080

# Optional: enable route-based proxy instead of Next.js rewrites.
# Values: route | (unset)
PROXY_MODE=

# Optional: keep /api/test available in production when set to true.
ENABLE_TEST_API_ROUTE=false

# -----------------------------
# Backend listener / CORS
# -----------------------------
# Go API bind address. PORT is used if GOAPI_ADDR is unset.
GOAPI_ADDR=:8080
PORT=8080

# Next dev port (scripts/start-frontend.sh)
# WEB_PORT=3000

# -----------------------------
# Execution layer RPC
# -----------------------------
# You can set either one RPC URL...
RPC_HTTP_URL=https://ethereum.publicnode.com
# ...or multiple providers for failover/racing:
# RPC_HTTP_URL1=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# RPC_HTTP_URL2=https://mainnet.infura.io/v3/YOUR_KEY

# Optional websocket endpoint for source display.
RPC_WS_URL=

# RPC timeout in seconds (1-60).
RPC_TIMEOUT_SECONDS=5

# -----------------------------
# Consensus / relay upstreams
# -----------------------------
BEACON_API_URL=https://beacon.prylabs.net
RELAY_URLS=https://boost-relay.flashbots.net,https://agnostic-relay.net
RELAY_BUDGET_MS=2500

# Shared upstream/cache tuning
UPSTREAM_TIMEOUT_SECONDS=3
CACHE_TTL_SECONDS=20
ERROR_CACHE_TTL_SECONDS=10
SNAPSHOT_TTL_SECONDS=30

# -----------------------------
# Domain feature tuning
# -----------------------------
MEMPOOL_DISABLE=false
MEV_MAX_TX=400
MEV_WORKERS=10
